# ── Public: Python research API ───────────────────────────────────────────────
NEXT_PUBLIC_POLICYLENS_API_URL=http://127.0.0.1:8000

# ── Public: canonical site URL (used for CORS in production) ─────────────────
NEXT_PUBLIC_SITE_URL=https://policylens.example.gov.in

# ── PostgreSQL database ───────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://neondb_owner:npg_BTmwIPhY4yg9@ep-steep-dust-b55q1d45-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Security: IP anonymisation salt ──────────────────────────────────────────
# Minimum 32 random characters. Change before first deployment.
SECURITY_IP_SALT=replace-with-a-long-random-string-at-least-32-chars

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank during local dev; the email service will log messages instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@policylens.example.gov.in
# SMTP_PASS=smtp-password-here
# EMAIL_FROM="PolicyLens <noreply@policylens.example.gov.in>"

# ── Session ───────────────────────────────────────────────────────────────────
# SESSION_SECRET is not required (tokens are random); but you may add one
# for additional MAC-based verification in the future.
# SESSION_SECRET=another-long-random-string
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Your App <onboarding@resend.dev>"

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development
